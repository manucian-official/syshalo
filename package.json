{
  "name": "@manucian-official/syshalo",
  "description": "Enterprise Brand Positioning, Strategic Pricing Guides & Active Security Audit Consoles built with React 19, TypeScript, and Gemini AI.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manucian-official/syshalo.git"
  },
  "bugs": {
    "url": "https://github.com/manucian-official/syshalo/issues"
  },
  "homepage": "https://github.com/manucian-official/syshalo#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "server.ts"
  ],
  "keywords": [
    "react-19",
    "vite",
    "typescript",
    "express-js",
    "gemini-ai",
    "brand-positioning",
    "security-console",
    "github-workflows"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
